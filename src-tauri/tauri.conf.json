{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThreadLine",
  "version": "0.1.4-rc.1",
  "identifier": "io.chenmiaoi.threadline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThreadLine",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#111216",
        "additionalBrowserArgs": "--disk-cache-size=33554432"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: asset: http://asset.localhost https://avatars.githubusercontent.com; connect-src ipc: http://ipc.localhost https://avatars.githubusercontent.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
