{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThreadLine",
  "version": "0.1.0",
  "identifier": "io.chenmiaoi.threadline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThreadLine",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#111216"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
